SHADOWVM_DB_URL=sqlite+aiosqlite:///./shadowvm.db
SHADOWVM_KMS_BACKEND=file
SHADOWVM_KMS_KEYRING=./keyring.json
SHADOWVM_LISTEN=0.0.0.0:8443
SHADOWVM_TLS_CERT=./certs/fullchain.pem
SHADOWVM_TLS_KEY=./certs/privkey.pem
SHADOWVM_RATE_COMPILE_PER_HOUR=60
SHADOWVM_RATE_SESSION_PER_HOUR=600
SHADOWVM_RATE_BLOB_FETCH_PER_HOUR=3600
SHADOWVM_SESSION_TTL_MS=600000
